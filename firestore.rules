rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Valide le format et la longueur des codes d'établissements scolaires
    function isValidSchoolCode(code) {
      return code is string && code.size() >= 2 && code.size() <= 64;
    }

    // Répertoire des établissements scolaires enregistrés
    match /school_directory/{schoolCode} {
      allow read, write: if isValidSchoolCode(schoolCode);
    }

    // Données isolées par établissement : paramètres, élèves, classes, matières, notes, paiements, présences, journaux
    match /schools/{schoolCode}/{allSchoolPaths=**} {
      allow read, write: if isValidSchoolCode(schoolCode);
    }

    // Historique des scans QR (lecture/écriture sécurisée)
    match /scan_history/{docId} {
      allow read, write: if docId is string && docId.size() > 0;
    }

    // Refus strict de tout autre accès par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
